<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <data noupdate="0">

        <!-- ══ Default record created on install only, not overwritten on upgrade ══ -->
        <record id="aioa_settings_default" model="x_aioa.settings">
            <field name="x_name">Default</field>
            <field name="x_color_code">420083</field>
            <field name="x_style">bottom_right</field>
            <field name="x_icon_type">aioa-icon-type-1</field>
            <field name="x_icon_size_desktop">aioa-default-icon</field>
            <field name="x_size">regular</field>
        </record>
    </data>

    <data>

        <!-- ══ List View ══ -->
        <record id="view_aioa_settings_list" model="ir.ui.view">
            <field name="name">x_aioa.settings.list</field>
            <field name="model">x_aioa.settings</field>
            <field name="arch" type="xml">
                <list string="All in One Accessibility Settings" create="false" delete="false">
                    <field name="x_color_code"/>
                    <field name="x_style"/>
                    <field name="x_icon_type"/>
                    <field name="x_size"/>
                </list>
            </field>
        </record>

        <!-- ══ Form View ══ -->
        <record id="view_aioa_settings_form" model="ir.ui.view">
            <field name="name">x_aioa.settings.form</field>
            <field name="model">x_aioa.settings</field>
            <field name="arch" type="xml">
                <form string="All in One Accessibility" create="false" delete="false">
                    <header>
                        <!-- Order on click: (1) JS validates the form (aioa_save_sync_patch.js)
                             -> (2) record is saved -> (3) the ir.actions.server below
                             re-validates and writes the local ir.config_parameter
                             values (read by the frontend <script> tag) -> (4) JS
                             syncs the validated values to Skynet/ADA. Nothing is
                             sent to ADA unless validation passed. No license key
                             involved anywhere: your domain is registered
                             automatically the first time this form opens (see
                             the aioa_register_domain widget just below), keyed
                             off this site's own URL. -->
                        <button name="odoo_allinoneaccessibility.action_aioa_save_and_sync"
                                type="action"
                                string="Save and Sync Widget"
                                class="btn-primary"
                                save="1"/>
                    </header>
                    <sheet>

                        <!-- Cache note — shown at the top of the settings page -->
                        <div class="alert alert-info" role="alert">
                            It may take a few seconds for changes to appear on your website. If you don't see the changes, try clearing your browser cache or checking in a private browsing window.
                        </div>

                        <!-- Fires add-user-domain once per browser session when
                             this form opens. No license key/token needed —
                             Skynet identifies the site by domain. Backend-only,
                             does not touch the frontend. -->
                        <widget name="aioa_register_domain"/>

                        <group string="All in One Accessibility Settings Page">
                            <group>
                                <field name="x_color_code"
                                       placeholder="420083"/>
                            </group>
                            <group>
                                <div class="text-muted">
                                    Enter hex color without the # symbol.<br/>
                                    Example: FF5733
                                </div>
                            </group>
                        </group>

                        <group string="Widget Position">
                            <group>
                                <field name="x_precise_position"/>
                                <field name="x_style"
                                       invisible="x_precise_position"/>
                                <field name="x_offset_right"
                                       invisible="not x_precise_position"/>
                                <div colspan="2" class="text-muted small mb-2"
                                     invisible="not x_precise_position">
                                    Right offset (PX) must be between 0 and 250.
                                </div>
                                <field name="x_offset_right_dir"
                                       invisible="not x_precise_position"/>
                                <field name="x_offset_bottom"
                                       invisible="not x_precise_position"/>
                                <div colspan="2" class="text-muted small mb-2"
                                     invisible="not x_precise_position">
                                    Bottom offset (PX) must be between 0 and 250.
                                </div>
                                <field name="x_offset_bottom_dir"
                                       invisible="not x_precise_position"/>
                            </group>
                        </group>

                        <group string="Widget &amp; Icon Appearance">
                            <group>
                                <field name="x_size"/>
                                <field name="x_icon_type"/>
                                <field name="x_custom_icon_size"/>
                                <field name="x_icon_size_desktop"
                                       invisible="x_custom_icon_size"/>
                                <field name="x_custom_icon_size_px"
                                       invisible="not x_custom_icon_size"/>
                                <div colspan="2" class="text-muted small mb-2"
                                     invisible="not x_custom_icon_size">
                                    Custom icon size must be between 20 and 150 PX.
                                </div>
                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- ══ Window Action ══
             Always opens the one default settings record directly (no list view,
             no "New" button). Without res_id + view_mode="form" here, opening the
             action could land on the list view first — clicking "New" there created
             a blank, unrelated settings record and made the real configured record
             disappear from view. Pointing straight at aioa_settings_default and
             disabling create/delete makes this behave like a proper singleton
             settings page. ══ -->
        <record id="action_aioa_settings_window" model="ir.actions.act_window">
            <field name="name">All in One Accessibility</field>
            <field name="res_model">x_aioa.settings</field>
            <field name="view_mode">form</field>
            <field name="res_id" ref="aioa_settings_default"/>
            <field name="target">current</field>
            <field name="context">{'create': False, 'delete': False}</field>
        </record>
        <record id="action_aioa_settings_window_view_form" model="ir.actions.act_window.view">
            <field name="sequence">1</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_aioa_settings_form"/>
            <field name="act_window_id" ref="action_aioa_settings_window"/>
        </record>

        <!-- ══ Root app menu ══
             `application: True` in __manifest__.py only marks the module as
             an app in the Apps list; the tile in the app switcher / home
             menu comes from a ROOT ir.ui.menu record (no parent), and this
             module previously defined none — so it installed fine but never
             appeared as an app, and the only way in was Settings → "Configure
             Widget". web_icon points at the module's existing icon.png.
             Restricted to Settings administrators, matching the write access
             on x_aioa.settings and the server action that saves it. ══ -->
        <menuitem id="menu_aioa_root"
                  name="All in One Accessibility"
                  action="action_aioa_settings_window"
                  web_icon="odoo_allinoneaccessibility,static/description/icon.png"
                  groups="base.group_system"
                  sequence="90"/>

        <!-- ══ Inject into Odoo General Settings page ══ -->
        <record id="res_config_settings_view_aioa_inject" model="ir.ui.view">
            <field name="name">res.config.settings.view.aioa.inject</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <div id="aioa_settings_section" class="o_setting_box col-xs-12 col-md-6">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <div class="o_form_label">
                                <strong>All in One Accessibility</strong>
                            </div>
                            <div class="text-muted mt4 mb8">
                                Website accessibility widget for improving WCAG 2.0, 2.1, 2.2 and ADA, EAA compliance.
                            </div>
                            <a type="action"
                               name="odoo_allinoneaccessibility.action_aioa_settings_window"
                               class="btn btn-secondary btn-sm"
                               role="button">
                                Configure Widget &#8594;
                            </a>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
